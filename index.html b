<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>Handball Stats Hub</title>
<meta name="theme-color" content="#0d1117" />
<meta name="description" content="ハンドボール試合データ記録・分析アプリ" />

<!-- PWA -->
<link rel="manifest" href="manifest.json" />
<link rel="apple-touch-icon" href="icons/icon-192.png" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Handball Stats" />

<link rel="stylesheet" href="style.css" />
</head>
<body>

<div id="app">

  <!-- ============================================================ -->
  <!-- SCREEN 1: HOME                                                -->
  <!-- ============================================================ -->
  <section id="screen-home" class="screen active">
    <div class="home-hero">
      <h1 class="home-title">Handball Stats Hub</h1>
      <div class="home-actions">
        <button id="btn-goto-new-match" class="btn btn-primary btn-block">NEW MATCH</button>
        <button id="btn-goto-history" class="btn btn-secondary btn-block">MATCH HISTORY</button>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- SCREEN 2: NEW MATCH SETUP                                     -->
  <!-- ============================================================ -->
  <section id="screen-new-match" class="screen">
    <button id="btn-back-home" class="btn btn-back">
      <span class="back-arrow">←</span>
      <span id="match-status-label">NO MATCH STARTED</span>
    </button>

    <h2 class="section-heading">MATCH INFORMATION</h2>

   <label class="field-label" for="match-date">DATE</label>
<input type="date" id="match-date" class="field-input" />

    <label class="field-label" for="input-my-team">MY TEAM</label>
    <input type="text" id="input-my-team" class="field-input" placeholder="Team name" />

    <label class="field-label" for="opponent-name">OPPONENT</label>
    <input type="text" id="opponent-name" class="field-input" placeholder="Opponent name" />

    <button id="btn-start-match" class="btn btn-primary btn-block btn-large">START MATCH</button>
  </section>

  <!-- ============================================================ -->
  <!-- SCREEN 3: RECORD (LIVE MATCH INPUT)                           -->
  <!-- ============================================================ -->
<section id="screen-record" class="screen">

    <!-- ========================= -->
    <!-- Header -->
    <!-- ========================= -->

    <div class="record-header">

        <h1 class="app-title">
            Handball Stats Hub
        </h1>

        <div
            class="half-label"
            id="half-label">

            1st Half

        </div>

    </div>

    <!-- ========================= -->
    <!-- Team -->
    <!-- ========================= -->

    <div id="team-toggle">

        <button
            id="btn-team-my"
            class="toolbar-btn active"
            data-team="my">

            MY TEAM

        </button>

        <button
            id="btn-team-opponent"
            class="toolbar-btn"
            data-team="opponent">

            OPPONENT

        </button>

    </div>

    <!-- ========================= -->
    <!-- Timer -->
    <!-- ========================= -->

    <div class="timer-area">

        <div id="match-timer">

            00:00

        </div>

    </div>

    <!-- ========================= -->
    <!-- Timer Buttons -->
    <!-- ========================= -->

    <div class="timer-buttons">

        <button id="btn-minus10">
            -10
        </button>

        <button id="btn-minus1">
            -1
        </button>

        <button id="btn-start-timer">
            START
        </button>

        <button id="btn-plus1">
            +1
        </button>

        <button id="btn-plus10">
            +10
        </button>

    </div>

    <!-- ========================= -->
    <!-- Main Grid -->
    <!-- ========================= -->

    <div class="record-grid">
    
        <!-- ====================================== -->
    <!-- POSITION -->
    <!-- ====================================== -->

    <div class="record-column">

        <h3>POSITION</h3>

        <div class="position-panel">

            <button class="position-btn" data-position="GK">
                <span>GK</span>
                <input
                    class="number-input"
                    data-number-position="GK"
                    type="text"
                    maxlength="2"
                    inputmode="numeric"
                    placeholder="#">
            </button>

            <button class="position-btn" data-position="EP">
                <span>EP</span>
                <input
                    class="number-input"
                    data-number-position="EP"
                    type="text"
                    maxlength="2"
                    inputmode="numeric"
                    placeholder="#">
            </button>

            <button class="position-btn" data-position="LW">
                <span>LW</span>
                <input class="number-input" data-number-position="LW" type="text" maxlength="2" inputmode="numeric" placeholder="#">
            </button>

            <button class="position-btn" data-position="PV">
                <span>PV</span>
                <input class="number-input" data-number-position="PV" type="text" maxlength="2" inputmode="numeric" placeholder="#">
            </button>

            <button class="position-btn" data-position="RW">
                <span>RW</span>
                <input class="number-input" data-number-position="RW" type="text" maxlength="2" inputmode="numeric" placeholder="#">
            </button>

            <button class="position-btn" data-position="LB">
                <span>LB</span>
                <input class="number-input" data-number-position="LB" type="text" maxlength="2" inputmode="numeric" placeholder="#">
            </button>

            <button class="position-btn" data-position="CB">
                <span>CB</span>
                <input class="number-input" data-number-position="CB" type="text" maxlength="2" inputmode="numeric" placeholder="#">
            </button>

            <button class="position-btn" data-position="RB">
                <span>RB</span>
                <input class="number-input" data-number-position="RB" type="text" maxlength="2" inputmode="numeric" placeholder="#">
            </button>

        </div>

    </div>

    <!-- ====================================== -->
    <!-- COURSE -->
    <!-- ====================================== -->

    <div class="record-column">

        <h3>COURSE</h3>

        <div class="course-panel">

            <button class="course-btn" data-course="LT">LT</button>
            <button class="course-btn" data-course="CT">CT</button>
            <button class="course-btn" data-course="RT">RT</button>

            <button class="course-btn" data-course="LM">LM</button>
            <button class="course-btn" data-course="CM">CM</button>
            <button class="course-btn" data-course="RM">RM</button>

            <button class="course-btn" data-course="LB9">LB</button>
            <button class="course-btn" data-course="CB9">CB</button>
            <button class="course-btn" data-course="RB9">RB</button>

        </div>

    </div>
    
        <!-- ====================================== -->
    <!-- SHOT TYPE -->
    <!-- ====================================== -->

    <div class="record-column">

        <h3>TYPE</h3>

        <div class="type-panel">

            <button class="type-btn" data-shot-type="Normal">
                Normal
            </button>

            <button class="type-btn" data-shot-type="Fast Break">
                Fast Break
            </button>

            <button class="type-btn" data-shot-type="7m">
                7m
            </button>

        </div>

    </div>

    <!-- ====================================== -->
    <!-- RESULT -->
    <!-- ====================================== -->

    <div class="record-column">

        <h3>RESULT</h3>

        <div class="result-panel">

            <button class="result-btn result-goal" data-result="GOAL">
                GOAL
            </button>

            <button class="result-btn result-saved" data-result="SAVED">
                SAVED
            </button>

            <button class="result-btn result-miss" data-result="MISS">
                MISS
            </button>

            <button class="result-btn result-block" data-result="BLOCK">
                BLOCK
            </button>

        </div>

    </div>

</div>

<!-- ====================================== -->
<!-- Bottom Controls -->
<!-- ====================================== -->

<div class="bottom-controls">

    <div class="utility-buttons">

        <button id="btn-other">
            OTHER
        </button>

        <button id="btn-history">
            HISTORY
        </button>

        <button id="btn-undo">
            UNDO
        </button>

    </div>

    <button id="btn-change-half">
        CHANGE HALF
    </button>

    <button id="btn-save-event">
        SAVE EVENT
    </button>

    <button id="btn-end-match">
        END & SAVE MATCH
    </button>

</div>

<!-- ====================================== -->
<!-- Match History -->
<!-- ====================================== -->

<div class="record-history">

    <div
        id="history-list-record"
        class="history-list">

    </div>

</div>

</section>
    
  <!-- ============================================================ -->
  <!-- SCREEN 4: MATCH HISTORY LIST                                  -->
  <!-- ============================================================ -->
  <section id="screen-history" class="screen">
    <h2 class="page-title">MATCH HISTORY</h2>
    <button id="btn-back-from-history" class="btn btn-back">
      <span class="back-arrow">←</span> BACK
    </button>
    <div id="history-list" class="history-list">
      <!-- match cards injected by storage.js / main.js -->
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- SCREEN 5: ANALYSIS                                            -->
  <!-- ============================================================ -->
  <section id="screen-analysis" class="screen">
    <button id="btn-back-from-analysis" class="btn btn-back">
      <span class="back-arrow">←</span> BACK
    </button>

    <div class="tabs" id="analysis-tabs">
      <button class="tab-btn active" data-tab="overview">OVERVIEW</button>
      <button class="tab-btn" data-tab="players">PLAYERS</button>
      <button class="tab-btn" data-tab="gk">GK</button>
    </div>

    <!-- OVERVIEW TAB -->
    <div id="tab-overview" class="tab-panel active">
      <div class="analysis-card">
        <h3 class="analysis-card-title">OVERVIEW</h3>
        <div class="stat-grid">
          <div class="stat-cell"><span class="stat-label">GOALS</span><span class="stat-value" id="stat-goals">0</span></div>
          <div class="stat-cell"><span class="stat-label">SHOTS</span><span class="stat-value" id="stat-shots">0</span></div>
          <div class="stat-cell"><span class="stat-label">SHOT %</span><span class="stat-value" id="stat-shot-pct">0%</span></div>
          <div class="stat-cell"><span class="stat-label">ATTACK %</span><span class="stat-value" id="stat-attack-pct">0%</span></div>
          <div class="stat-cell"><span class="stat-label">SET %</span><span class="stat-value" id="stat-set-pct">0%</span></div>
          <div class="stat-cell"><span class="stat-label">FAST BREAK %</span><span class="stat-value" id="stat-fastbreak-pct">0%</span></div>
          <div class="stat-cell"><span class="stat-label">7M %</span><span class="stat-value" id="stat-7m-pct">0%</span></div>
          <div class="stat-cell"><span class="stat-label">MISTAKES</span><span class="stat-value" id="stat-mistakes">0</span></div>
          <div class="stat-cell stat-cell-wide"><span class="stat-label">MISTAKE %</span><span class="stat-value" id="stat-mistake-pct">0%</span></div>
        </div>
        <p class="half-breakdown" id="half-breakdown-1">1ST HALF 0 GOALS / 0 SHOTS / 0%</p>
        <p class="half-breakdown" id="half-breakdown-2">2ND HALF 0 GOALS / 0 SHOTS / 0%</p>
      </div>
    </div>

    <!-- PLAYERS TAB -->
    <div id="tab-players" class="tab-panel">
      <div id="players-list" class="players-list">
        <!-- per-player cards injected by analysis.js -->
      </div>
    </div>

    <!-- GK TAB -->
    <div id="tab-gk" class="tab-panel">
      <div class="analysis-card">
        <h3 class="analysis-card-title">GOALKEEPER</h3>
        <div class="stat-grid">
          <div class="stat-cell"><span class="stat-label">SAVES</span><span class="stat-value" id="gk-saves">0</span></div>
          <div class="stat-cell"><span class="stat-label">SHOTS FACED</span><span class="stat-value" id="gk-shots-faced">0</span></div>
          <div class="stat-cell stat-cell-wide"><span class="stat-label">SAVE %</span><span class="stat-value" id="gk-save-pct">0%</span></div>
        </div>
        <p class="best-worst-line" id="gk-best-course">BEST COURSE: -</p>
        <p class="best-worst-line" id="gk-worst-course">WORST COURSE: -</p>
        <div class="course-breakdown-grid" id="gk-course-breakdown">
          <!-- 9-zone save% breakdown injected by analysis.js -->
        </div>
      </div>
    </div>

  </section>

</div>

<!-- ============================================================ -->
<!-- MODAL (OTHER / IN-MATCH HISTORY / CONFIRM)                    -->
<!-- ============================================================ -->
<div id="modal-overlay" class="modal-overlay hidden">
  <div class="modal-box" id="modal-box">
    <button id="modal-close" class="modal-close">×</button>
    <div id="modal-content"></div>
  </div>
</div>

<!-- ============================================================ -->
<!-- AUTH FOOTER (Firebase Google Sign-In)                         -->
<!-- ============================================================ -->
<footer id="auth-footer">
  <button id="btn-google-login" class="btn btn-google">Googleでログイン</button>
  <button id="btn-logout" class="btn btn-logout hidden">ログアウト</button>
</footer>

<!-- ============================================================ -->
<!-- Firebase SDK (compat build) -->
<!-- ============================================================ -->
<script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-firestore-compat.js"></script>

<!-- App scripts (load order matters: config/utility first, orchestration last) -->
<script src="firebase.js" defer></script>
<script src="storage.js" defer></script>
<script src="timer.js" defer></script>
<script src="game.js" defer></script>
<script src="analysis.js" defer></script>

</body>
</html>
